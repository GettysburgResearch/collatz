import Mathlib.Algebra.Polynomial.Eval.Degree
import Mathlib.Algebra.Polynomial.Degree.Lemmas
import Mathlib.Tactic.Ring

namespace MomentTransport
open Polynomial

/-- Exact transport of each homogeneous primitive eigenline candidate. -/
theorem homogeneous_edge {c d f : ℤ} {a : ℕ} (edge : 3*c+d=2^a*f)
    (n j : ℕ) (x y : ℤ) :
    (3*x)^n * (c*(3*x)+d*(x+2^a*y))^j =
      3^n*(2^a)^j*(x^n*(f*x+d*y)^j) := by
  have h : c*(3*x)+d*(x+2^a*y) = 2^a*(f*x+d*y) := by
    calc
      _ = (3*c+d)*x+2^a*(d*y) := by ring
      _ = _ := by rw [edge]; ring
  rw [h,mul_pow,mul_pow]; ring

/-- In degree at most m, the coefficient lattice generated by
1, (c+dX), ..., (c+dX)^m has independent coordinate divisors d^i. -/
theorem image_iff (c d : ℤ) (m : ℕ) (q : ℤ[X]) (degree : q.natDegree≤m) :
    (∃ p : ℤ[X], p.natDegree≤m ∧ p.comp (C d*X+C c)=q) ↔
      ∀ i, d^i ∣ q.coeff i := by
  classical
  constructor
  · rintro ⟨p,_,eq⟩ i
    refine ⟨(p.comp (X+C c)).coeff i,?_⟩
    have h : (p.comp (X+C c)).comp (C d*X)=q := by
      simpa only [comp_assoc,add_comp,X_comp,C_comp] using eq
    rw [←h,comp_C_mul_X_coeff,mul_comm]
  · intro div
    let f (i : ℕ) : ℤ := if q.coeff i=0 then 0 else Classical.choose (div i)
    have support : ∀ i, f i≠0 → i∈q.support := by
      intro i nz
      apply mem_support_iff.mpr
      intro h
      exact nz (by simp [f,h])
    let r : ℤ[X] := ⟨⟨Finsupp.onFinset q.support f support⟩⟩
    have rc (i : ℕ) : r.coeff i=f i := rfl
    have rd : r.natDegree≤m := by
      apply natDegree_le_iff_coeff_eq_zero.mpr
      intro i large
      rw [rc]; simp [f,coeff_eq_zero_of_natDegree_lt (degree.trans_lt large)]
    have dil : r.comp (C d*X)=q := by
      ext i
      rw [comp_C_mul_X_coeff,rc]
      by_cases zero : q.coeff i=0
      · simp [f,zero]
      · rw [show f i=Classical.choose (div i) by simp [f,zero],mul_comm]
        exact (Classical.choose_spec (div i)).symm
    refine ⟨r.comp (X-C c),?_,?_⟩
    · exact natDegree_comp_le.trans (by simpa only [natDegree_X_sub_C,Nat.mul_one] using rd)
    · simpa only [comp_assoc,sub_comp,X_comp,C_comp,add_sub_cancel_right] using dil

#print axioms homogeneous_edge
#print axioms image_iff
end MomentTransport
