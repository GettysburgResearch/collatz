  have b1 : orbit 2729375 8 = 23316974 ∧ oddCount 2729375 8 = 7 := by decide +kernel
  have b2 : orbit 23316974 8 = 7377637 ∧ oddCount 23316974 8 = 4 := by decide +kernel
  have b3 : orbit 7377637 8 = 2334332 ∧ oddCount 7377637 8 = 4 := by decide +kernel
  have b4 : orbit 2334332 8 = 2215795 ∧ oddCount 2334332 8 = 5 := by decide +kernel
  have b5 : orbit 2215795 8 = 701092 ∧ oddCount 2215795 8 = 4 := by decide +kernel
  have b6 : orbit 701092 4 = 131455 ∧ oddCount 701092 4 = 1 := by decide +kernel
  exact (joinCheckedBlocks b0 (joinCheckedBlocks b1 (joinCheckedBlocks b2 (joinCheckedBlocks b3 (joinCheckedBlocks b4 (joinCheckedBlocks b5 b6))))))

