theorem psi_expanding_seed :
    orbit 106495 52=131455 ∧ oddCount 106495 52=33 ∧
    orbit 319484 52=394364 ∧ oddCount 319484 52=33 :=
  ⟨psi_seed_input_trace.1, psi_seed_input_trace.2,
    psi_seed_source_trace.1, psi_seed_source_trace.2⟩

theorem psi_expanding_source_certificate : orbit 319484 196=1 :=
  psi_seed_complete_trace.1

def psiExpansionInput (h : Nat) : Nat := 106495+2^52*h
def psiExpansionOutput (h : Nat) : Nat := 131455+3^33*h

/-- A whole ordinary binary cylinder, with its actual source and target paths.
The parameter h is unrestricted; no bounded enumeration proves this theorem. -/
theorem psi_expanding_family (h : Nat) :
    orbit (psiExpansionInput h) 52=psiExpansionOutput h ∧
    PsiReturn (psiExpansionInput h) 52 := by
  have seed := psi_expanding_seed
  constructor
  · unfold psiExpansionInput psiExpansionOutput
    rw [(high_bit_lift 106495 52 h).1, seed.1, seed.2.1]
  · unfold PsiReturn psiExpansionInput
    have e : 3*(106495+2^52*h)-1=319484+2^52*(3*h) := by omega
    rw [e, (high_bit_lift 319484 52 (3*h)).1,
      (high_bit_lift 106495 52 h).1, seed.1, seed.2.1,
      seed.2.2.1, seed.2.2.2]
    omega

/-- Every source value in this family strictly increases under the return. -/
theorem psi_expanding_family_increases (h : Nat) :
    psiExpansionInput h < psiExpansionOutput h := by
  unfold psiExpansionInput psiExpansionOutput
  omega

/-- Both the constant and coefficient pass the common-rank inequality, so
every member passes, not just the discovered seed. -/
theorem psi_expanding_family_guard (h : Nat) :
    psiExpansionOutput h*200^52 < psiExpansionInput h*201^52 := by
  have constant : 131455*200^52 < 106495*201^52 := by decide +kernel
  have coefficient : 3^33*200^52 < 2^52*201^52 := by decide +kernel
  have scaled := Nat.mul_le_mul_right h (Nat.le_of_lt coefficient)
  unfold psiExpansionInput psiExpansionOutput
  have left : (131455+3^33*h)*200^52 =
      131455*200^52+(3^33*200^52)*h := by
    rw [Nat.add_mul, Nat.mul_right_comm (3^33) h (200^52)]
  have right : (106495+2^52*h)*201^52 =
      106495*201^52+(2^52*201^52)*h := by
    rw [Nat.add_mul, Nat.mul_right_comm (2^52) h (201^52)]
  rw [left,right]
  exact Nat.add_lt_add_of_lt_of_le constant scaled

/-- Infinitely many parameters satisfy the ternary-unit side condition.
Source convergence is a separate supplied hypothesis. -/
theorem psi_expanding_family_unit (h : Nat) (hu : h%3 ≠ 2) :
    (psiExpansionInput h)%3 ≠ 0 := by
  unfold psiExpansionInput
  rw [Nat.add_mod, Nat.mul_mod]
  have a : 106495%3=1 := by decide
  rw [a,Nat.one_mul]
  omega

/-- The target certificate is transported in the direction required by the
recursive psi goal: convergence of the child implies convergence of the input. -/
theorem psi_expanding_family_target (h : Nat) :
    Basin (psiExpansionInput h) ↔ Basin (psiExpansionOutput h) := by
  have hb := orbit_basin (psiExpansionInput h) 52
  rw [(psi_expanding_family h).1] at hb
  exact hb.symm

/-- The actual supplied source witness, when long enough, loses 52 clocks.
No source convergence assumption for arbitrary h is manufactured here. -/
theorem psi_expanding_family_source {h d : Nat} (hd : 52 ≤ d)
    (hit : orbit (3*psiExpansionInput h-1) d=1) :
    orbit (3*psiExpansionOutput h-1) (d-52)=1 := by
  have e : 52+(d-52)=d := by omega
  have hreturn := (psi_expanding_family h).2
  change orbit (3*psiExpansionInput h-1) 52 =
    3*orbit (psiExpansionInput h) 52-1 at hreturn
  have hh := orbit_add (3*psiExpansionInput h-1) 52 (d-52)
  rw [e, hreturn, (psi_expanding_family h).1] at hh
  exact hh.symm.trans hit

/-- The full same-goal return decreases the actual known-source common rank,
for every supplied clock admitting the finite return. -/
theorem psi_expanding_family_rank {h d : Nat} (hd : 52 ≤ d) :
    ScoreLT (3*psiExpansionOutput h-1,d-52)
      (3*psiExpansionInput h-1,d) := by
  have hp : 0 < psiExpansionInput h := by unfold psiExpansionInput; omega
  have guard : (orbit (psiExpansionInput h) 52)*200^52 <
      psiExpansionInput h*201^52 := by
    rw [(psi_expanding_family h).1]
    exact psi_expanding_family_guard h
  have hs := psi_return_common_rank hp hd (psi_expanding_family h).2 guard
  rw [(psi_expanding_family h).2, (psi_expanding_family h).1] at hs
  exact hs

/-- Concrete supplied-source integration of the expanding seed. -/
theorem psi_expanding_seed_child_certificate : orbit 394364 144=1 := by
  have h := psi_expanding_family_source (h := 0) (d := 196) (by decide)
  exact h psi_expanding_source_certificate

theorem psi_expanding_seed_rank : ScoreLT (394364,144) (319484,196) := by
  exact psi_expanding_family_rank (h := 0) (d := 196) (by decide)

end CollatzGlobal
