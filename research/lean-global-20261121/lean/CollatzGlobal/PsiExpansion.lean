import CollatzGlobal.RankMoves

/-!
An expanding ordinary psi return that satisfies the strict common-rank guard,
and the whole unrestricted affine family generated by its binary cylinder.
This supplies a same-goal counterpart to the conjugated negative templates.
-/

open CollatzReverseBasin CollatzClosure

namespace CollatzGlobal

/- Concrete certificates use short blocks of literal arithmetic, joined by
ordinary orbit and odd-count concatenation. Every block is kernel checked. -/
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000
private theorem joinCheckedBlocks {n q r s t p1 p2 : Nat}
    (h1 : orbit n s = q ∧ oddCount n s = p1)
    (h2 : orbit q t = r ∧ oddCount q t = p2) :
    orbit n (s+t) = r ∧ oddCount n (s+t) = p1+p2 := by
  constructor
  · rw [orbit_add, h1.1, h2.1]
  · rw [oddCount_add, h1.1, h1.2, h2.2]

private theorem psi_seed_input_trace : orbit 106495 52 = 131455 ∧ oddCount 106495 52 = 33 := by
