import WordRank
set_option maxRecDepth 40000
set_option maxHeartbeats 0
set_option exponentiation.threshold 10000
namespace LogTowerData
open CollatzReverseBasin WordRank

def K : Nat := 2957
def A : Nat := 3^162
def seedB : Nat := 
def seedU : Nat := 
def a : Nat := 604638730941851140623317480411115249
def a0 : Nat := 5878029000896139928987816

/-- Efficient bounded computation of the normalized dyadic derivative. -/
def normResidue : Nat → Nat
  | 0 => ((A-1)/8) % 2^K
  | n+1 => let b:=normResidue n
           (b+2^(n+2)*b^2)%2^K

theorem finite_unit : normResidue 2955=seedB ∧
    (3^58*seedU)%2^K=seedB ∧ seedU<2^K ∧ seedU%2=1 := by decide +kernel

theorem anchors : 3^52*a=1+2^119*a0 ∧ a<2^119 ∧ 0<a ∧
    run 119 (a-1)=1+a0 ∧ odds 119 (a-1)=52 ∧
    run 119 (3^63*a-1)=1+3^71*a0 ∧ odds 119 (3^63*a-1)=60 := by decide +kernel

theorem terminal : run K (1+seedU)=run K (1+3^71*seedU) ∧
    odds K (1+seedU)=71+odds K (1+3^71*seedU) := by decide +kernel

#print axioms finite_unit
#print axioms anchors
#print axioms terminal
end LogTowerData
