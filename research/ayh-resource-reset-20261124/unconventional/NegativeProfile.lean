private def endpoint := ((replay (upper.map Checked.block) (1+3^37*negativeUnit)).getD (0,0)).1

private theorem upper_ok : replay (upper.map Checked.block) (1+3^37*negativeUnit)=
    some (endpoint,167282) := by decide +kernel
private theorem lower_ok : replay (lower.map Checked.block) (2+negativeUnit)=
    some (endpoint,167319) := by decide +kernel

/-- The complete physical orbit endpoints and grades at the negative
logarithmic unit representative. -/
theorem ordinary :
    run 334711 (1+3^37*negativeUnit)=run 334711 (2+negativeUnit) ∧
    odds 334711 (1+3^37*negativeUnit)=167282 ∧
    odds 334711 (2+negativeUnit)=167319 := by
  have u:=correct _ _ _ _ (certified upper) upper_ok
  have l:=correct _ _ _ _ (certified lower) lower_ok
  have cu : clockSum (upper.map Checked.block)=334711 := by decide +kernel
  have cl : clockSum (lower.map Checked.block)=334711 := by decide +kernel
  rw [cu] at u
  rw [cl] at l
  exact ⟨u.1.trans l.1.symm,u.2,l.2⟩

#print axioms ordinary
end NegativeProfile
