import ValuationReturns
import Mathlib.Data.Nat.ModEq
import Mathlib.Data.Nat.Prime.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Positivity

/-! A finite set of signed matches gives thirteen complete classes of
supplied hard exponents, including height savings up to 17,026 bits. -/
namespace Collatz.ValuationDictionary
open Itinerary Itinerary.ReturnDescent Itinerary.TowerFrontier Itinerary.ReturnDescent.ValuationReturns
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 60000
set_option maxHeartbeats 12000000
set_option exponentiation.threshold 60000

structure Entry where
  q : ℕ
  a : ℕ
  gap : ℕ
  savings : ℕ
  residue : ℕ
  deriving DecidableEq, Repr

def entryBase (e : Entry) : ℕ := e.residue

def Checked (e : Entry) : Prop :=
  let B:=12*2^e.q
  let M:=B*e.a-1
  let b:=entryBase e
  let h:=e.q+5
  e.a%2=1 ∧ 0<B*e.a ∧ M%162=11 ∧ (B*54)%162=0 ∧ e.gap<M ∧
  18+e.savings≤M ∧ clockCharge (M-e.gap)+e.savings≤e.gap ∧
  0<b ∧ b<2^h ∧ (3^(e.gap+1)*b)%2^h=1+2^(e.q+4) ∧
  stride h (3^e.gap*b-1) e.gap=stride h (b-1) 0

instance (e : Entry) : Decidable (Checked e) := by unfold Checked; infer_instance

/-- Each hexadecimal integer is the small ordinary representative of the earlier
power at the specified precision. The kernel checks its residue and both
literal Collatz paths. -/
