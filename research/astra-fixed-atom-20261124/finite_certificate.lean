import Std

namespace Collatz.FiniteCertificate

def step (n : Nat) : Nat :=
  if n % 2 = 0 then n / 2 else (3 * n + 1) / 2

def iterate : Nat → Nat → Nat
  | 0, n => n
  | k + 1, n => step (iterate k n)

-- Each set bit indexes a member of a finite forward-closed set. Generate
-- it by starting with 1 and 2, then visiting the iterates of each n=1,...,702
-- until an already included state is reached. The table theorems below
-- independently verify containment, closure and prefix exclusion in the kernel.
private def hullBits : Nat := 

private def inHull (n : Nat) : Bool :=
  decide (n ≤ 20762) && hullBits.testBit n

-- Check a bounded interval with logarithmic stack depth.
private def checkTree (p : Nat → Bool) : Nat → Nat → Bool
  | 0, a => p a
  | d + 1, a => checkTree p d a && checkTree p d (a + 2^d)

private theorem checkTree_sound (p : Nat → Bool) (d a n : Nat)
    (h : checkTree p d a = true) (lo : a ≤ n) (hi : n < a + 2^d) : p n = true := by
  induction d generalizing a with
  | zero =>
    have : n = a := by simp at hi; omega
    simpa [this, checkTree] using h
  | succ d ih =>
    simp only [checkTree, Bool.and_eq_true] at h
    rw [Nat.pow_succ] at hi
    by_cases side : n < a + 2^d
    · exact ih a h.1 lo side
    · exact ih (a + 2^d) h.2 (by omega) (by omega)

private def closedAt (n : Nat) : Bool := !inHull n || inHull (step n)

set_option maxHeartbeats 0 in
private theorem closedTable : checkTree closedAt 15 0 = true := by decide

private theorem lowerTable :
    checkTree (fun n => decide (n = 0 ∨ 702 < n) || inHull n) 10 0 = true := by decide

private theorem avoidTable :
    checkTree (fun i => decide (80 < i) || !inHull (iterate i 703)) 7 0 = true := by decide

private theorem hull_closed (n : Nat) (h : inHull n = true) : inHull (step n) = true := by
  have hb : n ≤ 20762 := by
    by_cases hn : n ≤ 20762
    · exact hn
    · simp [inHull, hn] at h
  have hc := checkTree_sound closedAt 15 0 n closedTable (by omega) (by change n < 32768; omega)
  simpa [closedAt, h] using hc

private theorem smaller_in_hull (n : Nat) (hp : 0 < n) (hb : n < 703) : inHull n = true := by
  have hn : n < 0 + 2^10 := by change n < 1024; omega
  have hc := checkTree_sound _ 10 0 n lowerTable (Nat.zero_le _) hn
  simpa [show n ≠ 0 by omega, show ¬702 < n by omega] using hc

private theorem prefix_outside (i : Nat) (hi : i < 81) : inHull (iterate i 703) = false := by
  have hn : i < 0 + 2^7 := by change i < 128; omega
  have hc := checkTree_sound _ 7 0 i avoidTable (Nat.zero_le _) hn
  simpa [show ¬80 < i by omega] using hc

/-- No positive start below 703, at any visitor clock, meets this 81-value prefix. -/
theorem no_earlier_meeting (n j i : Nat) (hp : 0 < n) (hb : n < 703) (hi : i < 81) :
    iterate j n ≠ iterate i 703 := by
  have inside : inHull (iterate j n) = true := by
    induction j with
    | zero => exact smaller_in_hull n hp hb
    | succ j ih => exact hull_closed _ ih
  intro eq
  rw [eq, prefix_outside i hi] at inside
  contradiction

set_option maxRecDepth 4000 in
theorem meeting_at_81 : iterate 81 703 = 628 := by decide

#print axioms no_earlier_meeting
#print axioms meeting_at_81

end Collatz.FiniteCertificate
