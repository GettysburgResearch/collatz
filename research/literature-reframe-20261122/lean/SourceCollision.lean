/-!
An ordinary fixed-source budget for collisions of arbitrary parity windows.

This is a finite, integral version of the parity-collision argument underlying
Dubickas, On integer sequences generated by linear maps (2009), Theorem 5.
No fixed repeated block, inverse clock, or conjectural convergence is assumed.
The asymptotic complexity consequence is credited to that paper.
-/

namespace CollatzSourceCollision

def step (n : Nat) : Nat :=
  if n%2=0 then n/2 else (3*n+1)/2

def orbit : Nat → Nat → Nat
  | 0,n => n
  | k+1,n => orbit k (step n)

/-- Equality of the actual next `L` parity symbols, including the current one. -/
def SamePrefix : Nat → Nat → Nat → Prop
  | 0,_,_ => True
  | L+1,x,y => x%2=y%2 ∧ SamePrefix L (step x) (step y)

private theorem doubled_even (n : Nat) (h : n%2=0) : 2*step n=n := by
  simp only [step,h,ite_true]
  omega

private theorem doubled_odd (n : Nat) (h : n%2=1) : 2*step n=3*n+1 := by
  simp only [step,h,show ¬(1:Nat)=0 by decide,ite_false]
  omega

/-- Equal actual parity windows force congruence of their ordinary sources.
The word may be chosen differently for every application of this theorem. -/
theorem parity_prefix_divisibility {L x y : Nat} (h : SamePrefix L x y) :
    (2 : Int)^L ∣ (x : Int)-y := by
  induction L generalizing x y with
  | zero => simp
  | succ L ih =>
    obtain ⟨head,tail⟩ := h
    have base := ih tail
    have twice : (2 : Int)^(L+1) ∣
        2*((step x : Int)-(step y : Int)) := by
      simpa [Int.pow_succ,Int.mul_comm] using Int.mul_dvd_mul_left 2 base
    by_cases even : x%2=0
    · have xe := doubled_even x even
      have ye := doubled_even y (by omega)
      have equation : 2*((step x : Int)-(step y : Int))=(x : Int)-y := by omega
      rwa [equation] at twice
    · have xo := doubled_odd x (by omega)
      have yo := doubled_odd y (by omega)
      have equation : 2*((step x : Int)-(step y : Int))=3*((x : Int)-y) := by omega
      rw [equation] at twice
      have ndvd : 2^(L+1) ∣ 3*((x : Int)-y).natAbs := by
        simpa [Int.natAbs_mul,Int.natAbs_pow] using
          Int.natAbs_dvd_natAbs.mpr twice
      have cancel : 2^(L+1) ∣ ((x : Int)-y).natAbs :=
        (Nat.Coprime.pow_left (L+1) (by decide : Nat.Coprime 2 3)).dvd_of_dvd_mul_left ndvd
      exact Int.natAbs_dvd_natAbs.mp (by simpa [Int.natAbs_pow] using cancel)

/-- A distinct pair with a common `L`-symbol parity window is separated by
at least `2^L` in the ordinary absolute value. -/
theorem parity_prefix_separation {L x y : Nat} (h : SamePrefix L x y)
    (different : x≠y) : 2^L≤((x : Int)-y).natAbs := by
  have nz : (x : Int)-y≠0 := by omega
  have div : 2^L ∣ ((x : Int)-y).natAbs := by
    simpa [Int.natAbs_pow] using
      Int.natAbs_dvd_natAbs.mpr (parity_prefix_divisibility h)
  exact Nat.le_of_dvd (Int.natAbs_pos.mpr nz) div

private theorem difference_le_max (x y : Nat) :
    ((x : Int)-y).natAbs≤max x y := by
  by_cases order : y≤x
  · have eq := Int.natAbs_sub_of_nonneg_of_le
      (by omega : 0≤(y : Int)) (by omega : (y : Int)≤x)
    rw [eq]
    simpa using (show x-y≤max x y by omega)
  · have swap : (x : Int)-y=-((y : Int)-x) := by omega
    rw [swap,Int.natAbs_neg]
    have eq := Int.natAbs_sub_of_nonneg_of_le
      (by omega : 0≤(x : Int)) (by omega : (x : Int)≤y)
    rw [eq]
    simpa using (show y-x≤max x y by omega)

private theorem step_height (n : Nat) : 2*(step n+1)≤3*(n+1) := by
  unfold step
  split <;> omega

/-- Exact integral height envelope for every ordinary shortcut trajectory. -/
theorem orbit_height (n k : Nat) :
    2^k*(orbit k n+1)≤3^k*(n+1) := by
  induction k generalizing n with
  | zero => simp [orbit]
  | succ k ih =>
    calc
      2^(k+1)*(orbit (k+1) n+1)=2*(2^k*(orbit k (step n)+1)) := by
        simp [orbit,Nat.pow_succ,Nat.mul_left_comm,Nat.mul_comm]
      _≤2*(3^k*(step n+1)) := Nat.mul_le_mul_left 2 (ih (step n))
      _=3^k*(2*(step n+1)) := by
        simp [Nat.mul_assoc,Nat.mul_left_comm,Nat.mul_comm]
      _≤3^k*(3*(n+1)) := Nat.mul_le_mul_left _ (step_height n)
      _=3^(k+1)*(n+1) := by simp [Nat.pow_succ,Nat.mul_assoc]

/-- A common finite time horizon gives one height envelope for every
earlier orbit state, even though the orbit need not be monotone. -/
theorem orbit_height_at {n j K : Nat} (time : j≤K) :
    2^K*(orbit j n+1)≤3^K*(n+1) := by
  have clocks : (K-j)+j=K := by omega
  calc
    2^K*(orbit j n+1)=2^(K-j)*(2^j*(orbit j n+1)) := by
      rw [← Nat.mul_assoc,← Nat.pow_add,clocks]
    _≤2^(K-j)*(3^j*(n+1)) := Nat.mul_le_mul_left _ (orbit_height n j)
    _≤3^(K-j)*(3^j*(n+1)) :=
      Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (by decide : 2≤3) (K-j))
    _=3^K*(n+1) := by rw [← Nat.mul_assoc,← Nat.pow_add,clocks]

/-- A uniform fixed-source collision budget. It applies to arbitrary
parity words at arbitrary positions, with no fixed-block restriction. -/
theorem source_collision_budget {n L i j K : Nat} (it : i≤K) (jt : j≤K)
    (same : SamePrefix L (orbit i n) (orbit j n))
    (different : orbit i n≠orbit j n) :
    2^(L+K)<3^K*(n+1) := by
  have gap := Nat.le_trans (parity_prefix_separation same different)
    (difference_le_max (orbit i n) (orbit j n))
  have pos : 0<2^K := Nat.pow_pos (by decide : 0<2)
  have bound : 2^K*(max (orbit i n) (orbit j n)+1)≤3^K*(n+1) := by
    by_cases order : orbit i n≤orbit j n
    · rw [Nat.max_eq_right order]
      exact orbit_height_at jt
    · rw [Nat.max_eq_left (by omega : orbit j n≤orbit i n)]
      exact orbit_height_at it
  calc
    2^(L+K)=2^K*2^L := by rw [Nat.pow_add,Nat.mul_comm]
    _≤2^K*max (orbit i n) (orbit j n) := Nat.mul_le_mul_left _ gap
    _<2^K*(max (orbit i n) (orbit j n)+1) := Nat.mul_lt_mul_of_pos_left (by omega) pos
    _≤3^K*(n+1) := bound

/-- Above the explicit source-height threshold, equal parity windows
must come from the same actual orbit state. -/
theorem no_distinct_collision {n L i j K : Nat} (it : i≤K) (jt : j≤K)
    (budget : 3^K*(n+1)≤2^(L+K))
    (same : SamePrefix L (orbit i n) (orbit j n)) : orbit i n=orbit j n := by
  apply Classical.byContradiction
  intro different
  have strict := source_collision_budget it jt same different
  omega

/-- An arbitrarily chosen doubled prefix is paid for by the same original
source. If it violates the budget, the source is actually periodic. -/
theorem doubled_prefix_forces_return {n L : Nat}
    (budget : 3^L*(n+1)≤2^(L+L))
    (same : SamePrefix L n (orbit L n)) : orbit L n=n := by
  symm
  exact no_distinct_collision (i:=0) (j:=L) (K:=L) (by omega) (by omega)
    budget same

#print axioms parity_prefix_divisibility
#print axioms parity_prefix_separation
#print axioms orbit_height
#print axioms orbit_height_at
#print axioms source_collision_budget
#print axioms no_distinct_collision
#print axioms doubled_prefix_forces_return

end CollatzSourceCollision
