theorem binary_to_canonical (x : ℕ) (res : x%16=1) (bad : ¬Basin x) (upper : Basin (3*x)) :
    ∃ y, ReverseDefect y ∧ y≤4096*x := localize 4096 plan checked x res bad upper

theorem bounded_defect (n : ℕ) (positive : 0<n) (bad : ¬Good n) :
    ∃ y, ReverseDefect y ∧ y≤98304*n := by
  obtain ⟨w,_,res,wb,b,g⟩:=ReturnTwentyFour.binary_defect n positive bad
  obtain ⟨y,defy,cap⟩:=binary_to_canonical w res
    (fun h => b ((GlobalReturnBudget.basin w).mp h)) ((GlobalReturnBudget.basin _).mpr g)
  exact ⟨y,defy,by omega⟩

theorem least_floor (z : ℕ) (least : ∀ y, ReverseDefect y → z≤y)
    (n : ℕ) (positive : 0<n) (below : 98304*n<z) : Good n := by
  by_contra bad
  obtain ⟨y,dy,cap⟩:=bounded_defect n positive bad
  exact (Nat.not_lt_of_ge (least y dy)) (by omega)

