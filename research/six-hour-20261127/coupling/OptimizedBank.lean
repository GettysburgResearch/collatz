import DefectBank

/-! Complete source-relative localization of every ordered 1-modulo-16
defect, including all alternatives at nonunit exchanges. -/
set_option autoImplicit false
set_option warningAsError true
namespace OptimizedBank
open DefectBank CollatzReverseBasin CollatzTwoOdd
open EarlierOffsets (Good)


private theorem combineTwo (K : ℕ) (o r : Row) (hs : List Row) (a b : Plan)
    (ha : check K a (sub o 2 0) (sub r 2 0) (hs.map (sub · 2 0))=true)
    (hb : check K b (sub o 2 1) (sub r 2 1) (hs.map (sub · 2 1))=true) :
    check K (.split2 a b) o r hs=true := by
  simp only [check,ha,hb,Bool.true_and]
private theorem combineThree (K : ℕ) (o r : Row) (hs : List Row) (a b c : Plan)
    (ha : check K a (sub o 3 0) (sub r 3 0) (hs.map (sub · 3 0))=true)
    (hb : check K b (sub o 3 1) (sub r 3 1) (hs.map (sub · 3 1))=true)
    (hc : check K c (sub o 3 2) (sub r 3 2) (hs.map (sub · 3 2))=true) :
    check K (.split3 a b c) o r hs=true := by
  simp only [check,ha,hb,hc,Bool.true_and]
private theorem combineUnit (K : ℕ) (o r : Row) (hs : List Row) (a : Plan)
    (guard : decide (r.1%48=0 ∧ r.2%48=1)=true)
    (ha : check K a o (one r) (r::hs)=true) : check K (.unit a) o r hs=true := by
  simp only [check,guard,ha,Bool.true_and]
private theorem combineNonunit (K : ℕ) (o r : Row) (hs : List Row) (a b : Plan)
    (guard : decide (r.1%6=0 ∧ r.2%6=3)=true)
    (ha : check K a o (two 16 r) (r::hs)=true)
    (hb : check K b o (two 32 r) (r::hs)=true) : check K (.nonunit a b) o r hs=true := by
  simp only [check,guard,ha,hb,Bool.true_and]

