private def Final (n : Nat) := ∃ w, ReverseDefect w ∧ w ≤ 2^40*n
private def Smaller (n : Nat) := Final n ∨ ∃ k, 0<k ∧ k<n ∧ f k=false
private inductive Desc
  | two (a b : Desc)
  | three (a b c : Desc)
  | segment (word : String) (dst : Row) (next : Desc)
  | jump (u : Row) (next : Desc)
  | finish
private def goodPath (root cur : Row) : Desc → Bool
  | .two a b => goodPath (sub root 2 0) (sub cur 2 0) a &&
      goodPath (sub root 2 1) (sub cur 2 1) b
  | .three a b c => goodPath (sub root 3 0) (sub cur 3 0) a &&
      goodPath (sub root 3 1) (sub cur 3 1) b && goodPath (sub root 3 2) (sub cur 3 2) c
  | .segment w dst s => (DirectedEleven.run w.toList cur == some dst) &&
      ((DirectedEleven.queries w.toList cur).isEmpty) && goodPath root dst s
  | .jump u s => (cur == form 6 u 3) && bounded cur root (2^12) &&
      goodPath root (form 3 cur 0) s
  | .finish => decide (cur.1 < root.1 ∧ 0<cur.2 ∧ cur.2≤root.2 ∧ (cur.2<root.2 ∨ root.2≤1))
private def Descends (root cur : Row) :=
    ∀ t, 1<V root t → f (V cur t)=false → Smaller (V root t)
private theorem subcase {root cur : Row} {m : Nat} (hm : 0<m)
    (each : ∀ j<m, Descends (sub root m j) (sub cur m j)) : Descends root cur := by
  intro t h d
  have z := each (t%m) (Nat.mod_lt _ hm) (t/m)
  simp only [valS,Nat.div_add_mod] at z
  exact z h d
private theorem finishV {root cur : Row} {t : Nat}
    (ok : cur.1<root.1 ∧ 0<cur.2 ∧ cur.2≤root.2 ∧ (cur.2<root.2 ∨ root.2≤1))
    (h : 1<V root t) : 0<V cur t ∧ V cur t<V root t := by
  obtain ⟨h1,h2,h3,h4⟩ := ok
  dsimp [V,DirectedEleven.value] at h ⊢
  by_cases z : t=0
  · subst t; simp at h ⊢; omega
  · have aux := Nat.mul_lt_mul_of_pos_right h1 (show 0<t by omega)
    omega
private theorem descSound (d : Desc) (root cur : Row) (hc : goodPath root cur d=true) :
    Descends root cur := by
  induction d generalizing root cur with
  | two a b ia ib =>
    simp only [goodPath,Bool.and_eq_true] at hc
    apply subcase (m:=2) (by decide); intro j hj
    rcases (show j=0∨j=1 by omega) with h|h <;> subst j
    · exact ia _ _ hc.1
    · exact ib _ _ hc.2
  | three a b c ia ib ic =>
    simp only [goodPath,Bool.and_eq_true] at hc
    apply subcase (m:=3) (by decide); intro j hj
    rcases (show j=0∨j=1∨j=2 by omega) with h|h|h <;> subst j
    · exact ia _ _ hc.1.1
    · exact ib _ _ hc.1.2
    · exact ic _ _ hc.2
  | segment word dst s ih =>
    simp only [goodPath,Bool.and_eq_true,beq_iff_eq,List.isEmpty_iff] at hc
    intro t h d
    apply ih _ _ hc.2 t h
    apply DirectedEleven.runSound (fun x => f x=false) (fun x => by simp [ev])
      (fun x => by simp [od]) _ _ _ hc.1.1 t _ d
    simp [hc.1.2]
  | jump u s ih =>
    simp only [goodPath,Bool.and_eq_true,beq_iff_eq] at hc
    intro t h d
    cases upper : f (3*V cur t) with
    | false => exact ih _ _ hc.2 t h (by simpa [valF] using upper)
    | true =>
      let a := 2*V u t+1
      have eq : V cur t=3*a := by rw [hc.1.1,valF]; dsimp [a]; omega
      have bad : D (3*a) := eq ▸ (show D (V cur t) from ⟨d,upper⟩)
      have cost := boundV hc.1.2 t
      rw [eq] at cost
      have ha : a%2=1 := by dsimp [a]; omega
      apply Or.inl
      rcases twoD a ha bad with l|r
      · obtain ⟨z,zz,zb⟩ := from16 (16*a+1) (by omega) l
        exact ⟨z,zz,by omega⟩
      · obtain ⟨z,zz,zb⟩ := from16 (32*a+1) (by omega) r
        exact ⟨z,zz,by omega⟩
  | finish =>
    intro t h df
    obtain ⟨h1,h2⟩ := finishV (of_decide_eq_true hc) h
    exact Or.inr ⟨_,h1,h2,df⟩

