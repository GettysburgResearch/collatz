/-- A positive nonbasin input produces a reverse defect in the stated residue
with a fully certified absolute height factor. -/
theorem bounded_return (n : Nat) (positive : 0<n) (bad : ¬Basin n) :
    ∃ w, ReverseDefect w ∧ w≤2^40*n := by
  have df : f n=false := by simpa [f] using bad
  change Final n
  clear bad
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases one : n=1
    · subst n; have known : Basin 1 := ⟨0,rfl⟩
      simp [f,known] at df
    by_cases even : n%2=0
    · have eq : n=2*(n/2) := by omega
      have d : f (n/2)=false := (ev _).symm.trans (eq ▸ df)
      obtain ⟨w,p,b⟩ := ih (n/2) (by omega) (by omega) d
      exact ⟨w,p,by omega⟩
    · have eq : V (2,1) (n/2)=n := by dsimp [V,DirectedEleven.value]; omega
      have a := descSound descent (2,1) (2,1) descentOK (n/2)
      rw [eq] at a
      rcases a (by omega) df with done|⟨k,hk,hkt,hb⟩
      · exact done
      · obtain ⟨w,p,b⟩ := ih k hkt hk hb
        exact ⟨w,p,by omega⟩
#print axioms bounded_return
end CollatzQuantitativeReturn
