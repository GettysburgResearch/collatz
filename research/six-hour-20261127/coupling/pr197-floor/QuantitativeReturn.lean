import TwoOddCertificate
import DirectedEleven
import UnitResidueExchange
import NonunitExit

/-! Bounded transport from an actual nonbasin input. All tests use exact
affine rows for the whole parent progression, including the intercept. -/
namespace CollatzQuantitativeReturn
open CollatzReverseBasin CollatzTwoOdd
open DirectedEleven (Row)
abbrev V := DirectedEleven.value
private def form (k : Nat) (u : Row) (b : Nat) : Row := (k*u.1,k*u.2+b)
private def sub (r : Row) (m j : Nat) : Row := (r.1*m,r.1*j+r.2)
private theorem valF (k : Nat) (u : Row) (b t : Nat) :
    V (form k u b) t = k * V u t + b := by simp [V,DirectedEleven.value,form]; ring
private theorem valS (r : Row) (m j t : Nat) : V (sub r m j) t = V r (m*t+j) := by
  simp [V,DirectedEleven.value,sub]; ring
private def bounded (s r : Row) (k : Nat) : Bool := decide (s.1≤k*r.1 ∧ s.2≤k*r.2)
private theorem boundV {s r : Row} {k : Nat} (h : bounded s r k=true) (t : Nat) :
    V s t ≤ k*V r t := by
  obtain ⟨h1,h2⟩ := of_decide_eq_true h
  exact (Nat.add_le_add (Nat.mul_le_mul_right t h1) h2).trans_eq (by
    simp [V,DirectedEleven.value]; ring)
private theorem stepB (n : Nat) : Basin (shortcut n) ↔ Basin n := by
  constructor
  · rintro ⟨k,h⟩; exact ⟨k+1,h⟩
  · rintro ⟨k,h⟩; cases k with
    | zero => change n=1 at h; subst n; exact ⟨1,rfl⟩
    | succ k => exact ⟨k,h⟩
private theorem evenB (n : Nat) : Basin (2*n) ↔ Basin n := by
  simpa [shortcut] using (stepB (2*n)).symm
private theorem oddB (n : Nat) : Basin (2*n+1) ↔ Basin (3*n+2) := by
  have h : shortcut (2*n+1)=3*n+2 := by simp [shortcut]; omega
  simpa [h] using (stepB (2*n+1)).symm
private noncomputable def f (n : Nat) : Bool := by classical exact decide (Basin n)
private theorem ev (n : Nat) : f (2*n)=f n := by classical simp only [f,evenB]
private theorem od (n : Nat) : f (2*n+1)=f (3*n+2) := by classical simp only [f,oddB]
private def D (x : Nat) := f x=false ∧ f (3*x)=true
private theorem asDef {v : Nat} (h : D v) (hm : v%48=17) : ReverseDefect v := by
  obtain ⟨l,u⟩ := h
  exact ⟨hm,by simpa [f] using u,by simpa [f] using l⟩
private theorem oneD (u : Nat) (h : D (48*u+1)) : D (64*u+1) := by
  obtain ⟨a,b⟩ := UnitResidueExchange.unit_one_exchange f ev od u
  refine ⟨a.trans h.1,?_⟩
  simpa only [show 3*(64*u+1)=192*u+3 by omega, b,show 144*u+3=3*(48*u+1) by omega] using h.2
private theorem twoD (u : Nat) (hu : u%2=1) (h : D (3*u)) : D (16*u+1) ∨ D (32*u+1) := by
  have ne : f (3*u) ≠ f (3*(3*u)) := by rw [h.1,h.2]; decide
  rcases NonunitExit.directed_successor f ev od u hu ne with l|r
  · exact Or.inl ⟨l.1.trans h.1,l.2.1.trans h.2⟩
  · exact Or.inr ⟨r.1.trans h.1,r.2.1.trans h.2⟩
private def Ans (x : Nat) := ∃ w, ReverseDefect w ∧ w≤2^23*x
private theorem eleven (q : Nat) (mq : q%32=11) (d : D q) (n : Nat)
    (height : q≤2^22*n) : Ans n := by
  let t := q/32
  have eq : q=32*t+11 := by dsimp [t]; omega
  obtain ⟨a,b⟩ := UnitResidueExchange.residue17_descends f ev od t
  rw [eq] at d
  refine ⟨48*t+17,asDef ⟨a.symm.trans d.1,?_⟩ (by omega),by omega⟩
  simpa only [show 3*(48*t+17)=144*t+51 by omega,←b,show 96*t+33=3*(32*t+11) by omega] using d.2
private inductive Bank
  | split (a b c : Bank)
  | one (u : Row) (s : Bank)
  | two (u : Row) (a b : Bank)
  | exit (u : Row)
  | hit (i : Nat) (word : String)
private def checkedB (orig cur : Row) (prev : List Row) : Bank → Bool
  | .split a b c =>
    checkedB (sub orig 3 0) (sub cur 3 0) (prev.map (sub · 3 0)) a &&
    checkedB (sub orig 3 1) (sub cur 3 1) (prev.map (sub · 3 1)) b &&
    checkedB (sub orig 3 2) (sub cur 3 2) (prev.map (sub · 3 2)) c
  | .one u s => (cur == form 48 u 1) && checkedB orig (form 64 u 1) (cur::prev) s
  | .two u a b => (cur == form 3 u 0) && decide (u.1%2=0 ∧ u.2%2=1) &&
    checkedB orig (form 16 u 1) (cur::prev) a && checkedB orig (form 32 u 1) (cur::prev) b
  | .exit u => (cur == form 48 u 17) && bounded cur orig (2^23)
  | .hit i word =>
    let row := (cur::prev)[i]!
    let m : DirectedEleven.Motif := ⟨"",0,row,word⟩
    decide (i<(cur::prev).length) && DirectedEleven.checked m &&
      (DirectedEleven.queries word.toList row).all (bounded · orig (2^22))
private def Meaning (orig cur : Row) (prev : List Row) := ∀ t, D (V cur t) →
    (∀ r ∈ prev,D (V r t)) → Ans (V orig t)
private theorem ternarySplit {orig cur : Row} {prev : List Row}
    (h : ∀ j < 3, Meaning (sub orig 3 j) (sub cur 3 j) (prev.map (sub · 3 j))) :
    Meaning orig cur prev := by
  intro t hc hp
  let j := t%3
  have eq : 3*(t/3)+j=t := by dsimp [j]; omega
  have x := h j (Nat.mod_lt _ (by decide)) (t/3)
  rw [valS,valS,eq] at x
  apply x hc
  intro r hr
  obtain ⟨s,hs,rfl⟩ := List.mem_map.mp hr
  simpa [valS,eq] using hp s hs
private theorem bankSound (b : Bank) (orig cur : Row) (prev : List Row)
    (yes : checkedB orig cur prev b=true) : Meaning orig cur prev := by
  induction b generalizing orig cur prev with
  | split a b c ia ib ic =>
    simp only [checkedB,Bool.and_eq_true] at yes
    apply ternarySplit
    intro j hj
    rcases (show j=0∨j=1∨j=2 by omega) with h|h|h <;> subst j
    · exact ia _ _ _ yes.1.1
    · exact ib _ _ _ yes.1.2
    · exact ic _ _ _ yes.2
  | one u s ih =>
    simp only [checkedB,Bool.and_eq_true,beq_iff_eq] at yes
    intro t hc hp
    apply ih _ _ _ yes.2 t
    · rw [valF]; apply oneD; simpa [yes.1,valF] using hc
    · simpa only [List.mem_cons,forall_eq_or_imp] using And.intro hc hp
  | two u a b ia ib =>
    simp only [checkedB,Bool.and_eq_true,beq_iff_eq,decide_eq_true_eq] at yes
    intro t hc hp
    have par : V u t%2=1 := by
      simp [V,DirectedEleven.value,Nat.add_mod,Nat.mul_mod,yes.1.1.2.1,yes.1.1.2.2]
    have hd : D (3*V u t) := by simpa [yes.1.1.1,valF] using hc
    have hist : ∀ r∈cur::prev,D (V r t) := by simpa using And.intro hc hp
    rcases twoD _ par hd with l|r
    · exact ia _ _ _ yes.1.2 t (by simpa [valF] using l) hist
    · exact ib _ _ _ yes.2 t (by simpa [valF] using r) hist
  | exit u =>
    simp only [checkedB,Bool.and_eq_true,beq_iff_eq] at yes
    intro t hc _
    exact ⟨V cur t,asDef hc (by rw [yes.1,valF]; omega),boundV yes.2 t⟩
  | hit i word =>
    simp only [checkedB,Bool.and_eq_true,decide_eq_true_eq,List.all_eq_true] at yes
    intro t hc hp
    let r := (cur::prev)[i]!
    have hh : r ∈ cur::prev := by
      dsimp [r]; rw [getElem!_pos (cur::prev) i yes.1.1]; exact List.getElem_mem ..
    have dr : D (V r t) := (List.mem_cons.mp hh).elim (fun e => e ▸ hc) (hp r)
    let P (x : Nat) := f x=false
    have nd : ¬P (3*V r t) := by dsimp [P]; rw [dr.2]; decide
    obtain ⟨s,hs,hmod,ls,rs⟩ := DirectedEleven.checkedSound yes.1.2 P
      (fun x => by simp [P,ev]) (fun x => by simp [P,od]) t dr.1 nd
    have hi : f (3*V s t)=true := by simpa [P] using rs
    exact eleven _ hmod ⟨ls,hi⟩ _ (boundV (yes.2 s hs) t)

private theorem bSplit {o r : Row} {p : List Row} {a b c : Bank}
    (ha : checkedB (sub o 3 0) (sub r 3 0) (p.map (sub · 3 0)) a=true)
    (hb : checkedB (sub o 3 1) (sub r 3 1) (p.map (sub · 3 1)) b=true)
    (hc : checkedB (sub o 3 2) (sub r 3 2) (p.map (sub · 3 2)) c=true) :
    checkedB o r p (.split a b c)=true := by simp [checkedB,ha,hb,hc]
private theorem bOne {o r u : Row} {p : List Row} {s : Bank}
    (h : (r == form 48 u 1)=true)
    (hs : checkedB o (form 64 u 1) (r::p) s=true) : checkedB o r p (.one u s)=true := by
  simp [checkedB,h,hs]
private theorem bTwo {o r u : Row} {p : List Row} {a b : Bank}
    (h : (r == form 3 u 0)=true) (par : decide (u.1%2=0 ∧ u.2%2=1)=true)
    (ha : checkedB o (form 16 u 1) (r::p) a=true) (hb : checkedB o (form 32 u 1) (r::p) b=true) :
    checkedB o r p (.two u a b)=true := by simp only [checkedB,h,par,ha,hb]; rfl
