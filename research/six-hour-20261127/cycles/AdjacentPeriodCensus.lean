structure Row where
  numerator : Nat
  period : Nat
  window : Nat
deriving DecidableEq

def endpointAgrees : List (Nat × Nat) → Nat → Nat → Bool
  | [], _, _ => true
  | (k, _) :: tail, n, d =>
    d != 0 && n / d == k && endpointAgrees tail d (n % d)

def buildRows : List (Nat × Nat) → Nat → Nat → Nat → Nat → List Row
  | [], _, _, _, _ => []
  | (k, b) :: rest, prevA, a, prevP, p =>
    let newA := k * a + prevA
    let newP := k * p + prevP
    ⟨newA, newP, b⟩ :: buildRows rest a newA p newP

def allRows : List Row := buildRows coefficientsAndWindows 0 1 1 0

def WithinScreen (r : Row) : Prop :=
  10^6 < r.period ∧ r.period ≤ 10^1000 ∧
  r.period * upperNum < r.numerator * upperDen ∧
  2^71 * (r.numerator * upperDen - r.period * upperNum) < r.period * upperDen

instance (r : Row) : Decidable (WithinScreen r) := by
  unfold WithinScreen
  infer_instance

def candidates : List Row := allRows.filter (fun r => decide (WithinScreen r))

def gapCeiling (r : Row) : Nat :=
  let delta := r.numerator * upperDen - r.period * upperNum
  (upperDen + delta - 1) / delta

def disjointPairs (r : Row) : Nat :=
  (2 * r.period - r.numerator) * (r.window - 1) / r.period

def Excluded (r : Row) : Prop :=
  2 ≤ r.window ∧ r.numerator < 2 * r.period ∧
  (r.window + 1) * 9 ^ (disjointPairs r) +
    (gapCeiling r + (r.window + 1) * 3 ^ r.window) * 7 ^ (disjointPairs r) <
    r.period * 9 ^ (disjointPairs r)

instance (r : Row) : Decidable (Excluded r) := by
  unfold Excluded
  infer_instance

theorem endpoint_order_and_precision :
    lowerNum * upperDen < upperNum * lowerDen ∧
    2 ^ 7300 * (upperNum * lowerDen - lowerNum * upperDen) < lowerDen * upperDen := by
  decide

theorem prescribed_coefficient_count : coefficientsAndWindows.length = 1944 := by rfl

theorem lower_euclidean_stream :
    endpointAgrees coefficientsAndWindows lowerNum lowerDen = true := by rfl

theorem upper_euclidean_stream :
    endpointAgrees coefficientsAndWindows upperNum upperDen = true := by rfl

theorem screened_candidate_count : candidates.length = 959 := by rfl

theorem all_screened_rows_pass : candidates.all (fun r => decide (Excluded r)) = true := by rfl

theorem every_screened_row_excluded :
    ∀ r ∈ allRows, WithinScreen r → Excluded r := by decide

end AdjacentPeriodCensus

