Collatz.NativeMinimum.minimum_is_odd {m : ℕ} (hm : 0 < m) (h : m ≤ Collatz.NativeMinimum.shortcut m) : m % 2 = 1
Collatz.NativeMinimum.two_step_non_descent_iff {m : ℕ} (hm : 0 < m) :
  m ≤ Collatz.NativeMinimum.shortcut m ∧ m ≤ Collatz.NativeMinimum.shortcut (Collatz.NativeMinimum.shortcut m) ↔
    m = 1 ∨ m % 4 = 3
Collatz.NativeMinimum.minimum_second_parity {m : ℕ} (hm : 0 < m)
