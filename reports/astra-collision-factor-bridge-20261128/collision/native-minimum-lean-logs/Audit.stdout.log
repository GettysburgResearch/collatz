Collatz.NativeMinimum.postminimum_orbit {n m a : ℕ} (hit : Collatz.NativeMinimum.shortcut^[a] n = m) (j : ℕ) :
  Collatz.NativeMinimum.shortcut^[a + j] n = Collatz.NativeMinimum.shortcut^[j] m
Collatz.NativeMinimum.second_parity_zero_iff_reaches_one {n m a : ℕ} (hm : 0 < m)
  (hit : Collatz.NativeMinimum.shortcut^[a] n = m) (lower : ∀ (t : ℕ), m ≤ Collatz.NativeMinimum.shortcut^[t] n) :
