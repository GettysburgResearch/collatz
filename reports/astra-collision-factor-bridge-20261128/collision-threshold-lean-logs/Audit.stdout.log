Collatz.CollisionThreshold.term_bound.{u_1} {ι : Type u_1} (b : ℝ) (w P : ι → ℝ) (hw : ∀ (i : ι), 0 ≤ w i)
  (hs : Summable w) (hm : b + ∑' (i : ι), w i ≤ 1) (hP : ∀ (i : ι), 2 ≤ P i) (i : ι) :
  0 ≤ w i ^ 2 / (4 * P i) ∧ w i ^ 2 / (4 * P i) ≤ (1 - b) * w i / 8
