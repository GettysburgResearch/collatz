CollatzActualPhase.actual_fourier_harmonic_bound (q gap : ℕ → ℕ) (N : ℕ) (h : ℤ) (hpos : ∀ i ≤ N, 0 < q i)
  (hdist : ∀ i < N, ∀ j < N, q i = q j → i = j) (hedge : ∀ i < N, 2 ^ gap i * q (i + 1) = 3 * q i + 1) :
  ‖CollatzActualPhase.unitPhase (↑h * (Real.log 3 / Real.log 2)) - 1‖ *
      ‖∑ i ∈ Finset.range N, CollatzActualPhase.unitPhase (↑h * (Real.log ↑(q i) / Real.log 2))‖ ≤
    2 + 2 * Real.pi * |↑h| / (3 * Real.log 2) * ↑(harmonic N)
CollatzActualPhase.actual_fourier_log_bound (q gap : ℕ → ℕ) (N : ℕ) (h : ℤ) (hpos : ∀ i ≤ N, 0 < q i)
  (hdist : ∀ i < N, ∀ j < N, q i = q j → i = j) (hedge : ∀ i < N, 2 ^ gap i * q (i + 1) = 3 * q i + 1) :
  ‖CollatzActualPhase.unitPhase (↑h * (Real.log 3 / Real.log 2)) - 1‖ *
      ‖∑ i ∈ Finset.range N, CollatzActualPhase.unitPhase (↑h * (Real.log ↑(q i) / Real.log 2))‖ ≤
    2 + 2 * Real.pi * |↑h| / (3 * Real.log 2) * (1 + Real.log ↑N)
