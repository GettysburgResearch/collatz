'CollatzPsiParity.collatz_of_odd_rank_step' depends on axioms: [propext, Classical.choice, Quot.sound]
def CollatzPsiParity.OddRankStep : Prop :=
∀ (n : ℕ),
  0 < n →
    n % 2 = 1 →
      (∀ (u : ℕ),
          0 < u →
            CollatzPsiParity.psiRank u < CollatzPsiParity.psiRank n →
              CollatzAffineJoint.Comparison CollatzAffineJoint.Kind.psi u) →
        CollatzAffineJoint.Comparison CollatzAffineJoint.Kind.psi n
