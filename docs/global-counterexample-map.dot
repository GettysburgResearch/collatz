digraph CollatzMapPass2 {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, labelloc="t",
         label="Global Collatz Counterexample Dependency Map — cartography pass 2",
         nodesep=0.34, ranksep=0.64, compound=true, splines=ortho];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=9, margin="0.12,0.07",
        color="#666666", fillcolor="#e5e7eb"];
  edge [fontname="Arial", fontsize=8, color="#555555", arrowsize=0.7];

  false [label="COLLATZ IS FALSE", shape=doubleoctagon, penwidth=2];
  cyc [label="Positive nontrivial cycle", shape=oval];
  div [label="Positive orbit avoids 1", shape=oval];
  third [label="Third component / equivalent witness", shape=oval];
  cyc -> false; div -> false; third -> false;

  subgraph cluster_cycle {
    label="Finite cycle — now active"; color="#267326"; style="rounded";
    ceq [label="Proved cycle equation", fillcolor="#c8f7c5", color="#267326"];
    active [label="Issue #9 staffed"];
    cert [label="Exact divisibility and valuation replay", shape=diamond];
    ceq -> active -> cert -> cyc;
  }

  subgraph cluster_fixed {
    label="Fixed finite-type regeneration"; color="#b45309"; style="rounded";
    f256 [label="Frozen corrected 256-stage class", fillcolor="#ffd6a5", color="#b45309"];
    eq258 [label="Primitive 258-coordinate equation", fillcolor="#ffd6a5", color="#b45309"];
    t9705 [label="T-9705 proposed exclusion", fillcolor="#ffd6a5", color="#b45309"];
    t9831 [label="T-9831 proposed finite-type theorem\nendpoint product Xi < 1", fillcolor="#ffd6a5", color="#b45309"];
    closed [label="Fixed low-Xi systems\nproposed closed", shape=octagon, fillcolor="#ffd6a5", color="#b45309", penwidth=2];
    f256 -> eq258 -> t9705 -> closed;
    t9831 -> closed;
  }

  subgraph cluster_cross {
    label="Cross-cycle / growing-type escape"; color="#9a7b00"; style="rounded";
    cell [label="m=22 head 2130\nfinite room opening", fillcolor="#fff2a8", color="#9a7b00"];
    exit [label="Exits phase-34 family", fillcolor="#fff2a8", color="#9a7b00"];
    cascade [label="Forced phase cascade", fillcolor="#fff2a8", color="#9a7b00"];
    loss [label="Initial phase-1 tail loses\n4230 bits / 10000 renewals", fillcolor="#fff2a8", color="#9a7b00"];
    pot [label="Regeneration potential\nor finite return?", shape=diamond];
    init [label="One positive ordinary initialization", shape=diamond];
    cell -> exit -> cascade -> loss -> pot -> init;
    init -> div; init -> cyc;
  }

  subgraph cluster_m1 {
    label="Centered 64→81 / M1"; color="#267326"; style="rounded";
    cent [label="Centered equivalence, cylinder,\nblock and recurrence chain\nindependently verified", fillcolor="#c8f7c5", color="#267326"];
    safety [label="Deterministic safety on\n(C_K,e_K,height)", shape=diamond];
    stab [label="Eventually-zero blocks", shape=diamond];
    bad [label="T-9318 unrestricted screen\nREFUTED", fillcolor="#ffc7c7", color="#aa1111"];
    good [label="T-9319 nonconstant repair\nPROVED", fillcolor="#c8f7c5", color="#267326"];
    cent -> safety -> stab -> div;
    bad -> good [style=dashed, label="repair"];
    good -> safety [style=dashed, label="filter"];
  }

  subgraph cluster_h {
    label="Partial H — quantitative fork"; color="#b45309"; style="rounded";
    press [label="Rounded-deficit pressure\n+ prime firewall", fillcolor="#ffd6a5", color="#b45309"];
    split [label="Finite-letter fresh-prime ghost\nor reset-renewal ray", shape=diamond];
    xi [label="Endpoint product Xi_H", shape=diamond];
    horb [label="Positive ordinary H orbit", shape=diamond];
    hno [label="Integral trap / Evertse exclusion", shape=diamond];
    press -> split -> xi;
    xi -> horb -> div;
    xi -> hno;
  }

  subgraph cluster_period {
    label="Completion-safe fixed-period filters"; color="#2563a8"; style="rounded";
    p19 [label="Periods 1..9 source-audited", fillcolor="#cfe8ff", color="#2563a8"];
    block [label="Block q-Gaussian / Christoffel program", fillcolor="#ffd6a5", color="#b45309"];
    gcd [label="Cubic outside-prime\ngcd/common content", shape=diamond];
    p19 -> block -> gcd;
    gcd -> safety [style=dashed, label="filter"];
  }

  subgraph cluster_other {
    label="Other short certificates"; color="#777777"; style="rounded";
    dfa [label="Regular sanctuary DFA", shape=diamond];
    cover [label="Coverage deficit C(x)<x", shape=diamond];
    cone [label="Third binary fixed ray", shape=diamond];
    dfa -> div; cover -> third; cone -> third;
  }

  legend_p [label="PROVED / independently verified", fillcolor="#c8f7c5", color="#267326"];
  legend_l [label="source-inspected literature", fillcolor="#cfe8ff", color="#2563a8"];
  legend_o [label="PROPOSED", fillcolor="#ffd6a5", color="#b45309"];
  legend_e [label="EMPIRICAL finite evidence", fillcolor="#fff2a8", color="#9a7b00"];
  legend_r [label="REFUTED / withdrawn", fillcolor="#ffc7c7", color="#aa1111"];
  legend_q [label="OPEN", fillcolor="#e5e7eb", color="#666666"];
  {rank=sink; legend_p; legend_l; legend_o; legend_e; legend_r; legend_q;}
}
